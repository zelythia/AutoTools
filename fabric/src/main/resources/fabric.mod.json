{
  "schemaVersion": 1,
  "id": "autotools",
  "version": "${version}",
  "name": "AutoTools",
  "description": "Automatically switch to the correct tool to use on a block/mob.",
  "authors": [
    "zelythia"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/minecraft_autotools",
    "issues": "https://github.com/zelythia/AutoTools/issues",
    "sources": "https://github.com/zelythia/AutoTools"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.zelythia.autotools.fabric.AutoToolsFabric"
    ],
    "modmenu": [
      "net.zelythia.autotools.fabric.compat.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "autotools-common.mixins.json"
  ],
  "accessWidener" : "autotools.accesswidener",
  "depends": {
    "fabricloader": ">=0.15",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=4.9"
  }
}